# Configuración de Supabase (Una base de datos por empresa)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anonima

# Configuración de Marca Blanca (Inyección por despliegue)
VITE_COMPANY_NAME="Empresa Logística Demo"
VITE_COMPANY_LOGO="/logo.svg"
VITE_COLOR_PRIMARY="#2563eb"
VITE_COLOR_PRIMARY_HOVER="#1d4ed8"
VITE_COLOR_PRIMARY_LIGHT="#dbeafe"
VITE_COLOR_SECONDARY="#475569"
VITE_COLOR_SECONDARY_HOVER="#334155"

VITE_COMPANY_DOMAIN="tuempresa.com"

# Observabilidad de errores en producción (opcional). Creá un proyecto en
# https://sentry.io (plataforma "React") y pegá acá el DSN que te den.
# Si se deja vacío, Sentry simplemente no se inicializa — no rompe nada
# en desarrollo local ni en un tenant que todavía no lo configuró.
VITE_SENTRY_DSN=

# Protección antibot en login/recuperación de contraseña (opcional). Creá un
# widget en https://dash.cloudflare.com (Turnstile) y pegá acá el Sitekey.
# La Secret Key va en Supabase Dashboard > Authentication > Bot and Abuse
# Protection, no en este archivo. Si se deja vacío, no se muestra CAPTCHA.
VITE_TURNSTILE_SITE_KEY=